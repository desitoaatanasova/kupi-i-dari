# Купи и Дари — backend environment (example)
# Copy to backend/.env and fill in local values. Never commit .env.

NODE_ENV=development
PORT=3001
TZ=Europe/Sofia

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kupi_i_dari
DB_USER=root
DB_PASSWORD=
DB_NAME_TEST=kupi_i_dari_test

# Auth (used from Phase 2 onward)
JWT_SECRET=

# CORS (comma-separated allowed origins; empty = allow all in non-production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Admin bootstrap seed (scripts/seed-admin.js)
SEED_ADMIN_PHONE=+359888000001
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Администратор
SEED_ADMIN_LAST_NAME=Купи и Дари
